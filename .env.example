# =============================================================================
# VEYRA — Environment Configuration Template
# Copy this file to .env.local for local development and set real values.
# NEVER commit .env.local or private keys to version control.
# =============================================================================

# Public Site & App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VEYRA
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Firebase Client SDK Configuration (Safe for browser bundle; protected by Security Rules + App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging (Optional Web Push VAPID Key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase App Check (Optional reCAPTCHA v3 Site Key for production protection)
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=

# Phone OTP Authentication Flag (Set true ONLY after Firebase Billing / Phone Auth & Authorized Domains are configured)
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false

# Local Firebase Emulator Suite (Set true for local dev/testing without live project costs)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# Maps Provider Configuration (Optional; map view stays explicitly disabled until configured)
NEXT_PUBLIC_MAPS_PROVIDER=none
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_)
# Used by Next.js API Route Handlers & scripts/init-admin.ts
# =============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Paste the PEM private key with literal \n escaped newlines (or provide GOOGLE_APPLICATION_CREDENTIALS file path outside repo)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional Email/Support Webhook or Contact Inbox
CONTACT_NOTIFICATION_WEBHOOK_URL=
